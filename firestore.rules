rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Product Rules ---
    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'category', 'price', 'unit', 'stock']) &&
             data.keys().size() >= 5 && data.keys().size() <= 6 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.category in ['meat', 'egg', 'veg'] &&
             data.price is number && data.price >= 0 &&
             data.unit in ['kg', 'pcs'] &&
             data.stock is number &&
             (!data.keys().hasAny(['minStock']) || data.minStock is number);
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow create: if isEmailVerified() && isValidId(productId) && isValidProduct(incoming());
      allow update: if isEmailVerified() && isValidProduct(incoming()) && (
        // Action: Stock update (decrement on sale or manual adjust)
        incoming().diff(existing()).affectedKeys().hasOnly(['stock']) ||
        // Action: Full Edit
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'price', 'unit', 'stock', 'minStock'])
      );
      allow delete: if isEmailVerified();
    }

    // --- Sale Rules ---
    function isValidSale(data) {
      return data.keys().hasAll(['items', 'total', 'date', 'paymentMethod']) &&
             data.keys().size() == 4 &&
             data.items is list && data.items.size() > 0 &&
             data.total is number && data.total >= 0 &&
             data.date is number &&
             data.paymentMethod in ['cash', 'card', 'upi'];
    }

    match /sales/{saleId} {
      allow read: if isSignedIn();
      allow create: if isEmailVerified() && isValidId(saleId) && isValidSale(incoming());
      allow update, delete: if false; // Invariant: Sales are immutable
    }

    // --- Expense Rules ---
    function isValidExpenseCategory(data) {
      return data.keys().hasAll(['name', 'type']) &&
             data.keys().size() == 2 &&
             data.name is string && data.name.size() > 0 &&
             data.type in ['inventory', 'operational', 'other'];
    }

    function isValidExpense(data) {
      return data.keys().hasAll(['title', 'amount', 'date', 'categoryId', 'paymentMethod', 'isInventory', 'createdAt']) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.amount is number && data.amount >= 0 &&
             data.date is number &&
             data.categoryId is string &&
             data.paymentMethod in ['cash', 'card', 'upi', 'bank_transfer', 'digital'] &&
             data.isInventory is bool &&
             data.createdAt is number &&
             (!data.keys().hasAny(['categoryName']) || data.categoryName is string) &&
             (!data.keys().hasAny(['vendorName']) || data.vendorName is string) &&
             (!data.keys().hasAny(['referenceNumber']) || data.referenceNumber is string) &&
             (!data.keys().hasAny(['description']) || data.description is string) &&
             (!data.keys().hasAny(['receiptImage']) || data.receiptImage is string) &&
             (!data.keys().hasAny(['productId']) || data.productId is string) &&
             (!data.keys().hasAny(['quantity']) || data.quantity is number) &&
             (!data.keys().hasAny(['unit']) || data.unit is string) &&
             (!data.keys().hasAny(['unitPrice']) || data.unitPrice is number);
    }

    match /expenseCategories/{categoryId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create, update: if isEmailVerified() && isValidExpenseCategory(incoming());
      allow delete: if isEmailVerified();
    }

    match /expenses/{expenseId} {
      allow read: if isSignedIn();
      allow create: if isEmailVerified() && isValidId(expenseId) && isValidExpense(incoming());
      allow update: if isEmailVerified() && isValidExpense(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasAny(['title', 'amount', 'date', 'categoryId', 'paymentMethod', 'isInventory', 'vendorName', 'referenceNumber', 'description', 'receiptImage', 'productId', 'quantity', 'unit', 'unitPrice']);
      allow delete: if isEmailVerified();
    }
  }
}
