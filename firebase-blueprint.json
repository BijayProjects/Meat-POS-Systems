{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A product available for sale in the shop",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "enum": ["meat", "egg", "veg"] },
        "price": { "type": "number" },
        "unit": { "enum": ["kg", "pcs"] },
        "stock": { "type": "number" },
        "minStock": { "type": "number" }
      },
      "required": ["name", "category", "price", "unit", "stock"]
    },
    "Sale": {
      "title": "Sale",
      "description": "A customer transaction",
      "type": "object",
      "properties": {
        "items": { "type": "array" },
        "total": { "type": "number" },
        "date": { "type": "number" },
        "paymentMethod": { "enum": ["cash", "card", "upi"] }
      },
      "required": ["items", "total", "date", "paymentMethod"]
    },
    "ExpenseCategory": {
      "title": "Expense Category",
      "description": "Category for shop expenses",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "enum": ["inventory", "operational", "other"] }
      },
      "required": ["name", "type"]
    },
    "Expense": {
      "title": "Expense",
      "description": "A comprehensive bill record for the shop",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "number" },
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "vendorName": { "type": "string" },
        "paymentMethod": { "enum": ["cash", "card", "upi", "bank_transfer", "digital"] },
        "referenceNumber": { "type": "string" },
        "description": { "type": "string" },
        "receiptImage": { "type": "string" },
        "isInventory": { "type": "boolean" },
        "productId": { "type": "string" },
        "quantity": { "type": "number" },
        "unit": { "type": "string" },
        "unitPrice": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["title", "amount", "date", "categoryId", "paymentMethod", "isInventory", "createdAt"]
    }
  },
  "firestore": {
    "/products": {
      "schema": "Product",
      "description": "Product inventory"
    },
    "/sales": {
      "schema": "Sale",
      "description": "Sales records"
    },
    "/expenses": {
      "schema": "Expense",
      "description": "Expense records"
    },
    "/expenseCategories": {
      "schema": "ExpenseCategory",
      "description": "Configurable expense categories"
    }
  }
}
